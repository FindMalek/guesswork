{
  "name": "guesswork",
  "version": "0.1.0",
  "description": "Fish-style zsh history autosuggestions, ranked by an AI model instead of prefix matching",
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p .",
    "suggest": "node src/cli.ts",
    "setup": "node src/setup.ts",
    "test:e2e": "zsh test/e2e.zsh"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "guesswork-suggest": "./src/cli.ts",
    "guesswork-setup": "./src/setup.ts"
  }
}
